{
  "name": "@adsoffice/adscrm-ecommerce",
  "version": "0.1.0",
  "description": "AdsCRM E-Ticaret (Delivery) API istemcisi — React / Next.js için katalog, sepet, checkout, online ödeme, müşteri hesabı, iade ve B2B fiyatları.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "default": "./src/react/index.js"
    },
    "./next": {
      "types": "./types/next.d.ts",
      "default": "./src/next/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test scripts/unit.test.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "adscrm",
    "ecommerce",
    "headless-commerce",
    "nextjs",
    "react",
    "delivery-api"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
